# Production values for the Vercel setup script (scripts/vercel-setup.sh).
# Copy to .env.production (gitignored) and fill in. Do not commit.

# Neon database (EU region); schema created with:
# DATABASE_URL=<this-url> pnpm --dir apps/cms exec payload migrate
DATABASE_URL=

# Random long string
PAYLOAD_SECRET=

# Cloudflare R2 (endpoint and keys from R2 -> Manage API Tokens)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=tonyzoooo-me-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public URL of the bucket (R2 -> bucket -> Settings -> Public Access)
R2_PUBLIC_URL=
