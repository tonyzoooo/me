# Database
# Local development: Postgres in Docker, published on localhost (see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 media storage (production; leave unset locally to store files on disk)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=my-bucket
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.your-domain.com

# Vercel Deploy Hook of the web project (production; leave unset locally)
# WEB_DEPLOY_HOOK_URL=
