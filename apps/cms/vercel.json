{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": { "installCommand": "pnpm install" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "headers": { "Content-Type": "application/json" }
    },
    {
      "src": "/media/(.*)",
      "dest": "/api/media/file/$1"
    }
  ]
}
