---
import BaseLayout from './BaseLayout.astro';
const { title, description, ...rest } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="post-content">
    <article class="prose">
      <slot {...rest} />
    </article>
  </main>
</BaseLayout>

<style>
  .post-content {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }
  
  .post-content .prose {
    max-width: none;
    line-height: 1.75;
  }
  
  .post-content .prose p {
    color: var(--text);
  }
  
  .post-content .prose h1,
  .post-content .prose h2,
  .post-content .prose h3,
  .post-content .prose h4,
  .post-content .prose h5,
  .post-content .prose h6 {
    color: var(--text);
    font-weight: 700;
    line-height: 1.25;
  }
  
  .post-content .prose h1 { font-size: var(--text-4xl); }
  .post-content .prose h2 { font-size: var(--text-3xl); }
  .post-content .prose h3 { font-size: var(--text-2xl); }
  .post-content .prose h4 { font-size: var(--text-xl); }
  .post-content .prose h5 { font-size: var(--text-lg); }
  
  .post-content .prose a {
    color: var(--color-link);
    text-decoration: underline;
  }
  
  .post-content .prose a:hover {
    color: var(--color-link-hover);
  }
  
  .post-content .prose strong {
    color: var(--text);
    font-weight: 600;
  }
  
  .post-content .prose blockquote {
    border-left: 3px solid var(--border);
    padding-left: 1rem;
    margin-left: 0;
    color: var(--text-muted);
    font-style: italic;
  }
</style>
