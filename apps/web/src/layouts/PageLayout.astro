---
import BaseLayout from './BaseLayout.astro';
const { title, description, ...rest } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="page-content">
    <div class="page-layout">
      <div class="page-body">
        <slot {...rest} />
      </div>
      <aside class="page-aside-rail">
        <slot name="aside" />
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .page-content {
    max-width: 75rem;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  .page-layout {
    display: grid;
    grid-template-columns: minmax(0, 42rem);
    justify-content: center;
  }

  .page-aside-rail {
    display: none;
  }

  @media (min-width: 1024px) {
    .page-layout {
      grid-template-columns: 1fr minmax(0, 42rem) 1fr;
      column-gap: 2.5rem;
    }

    .page-body {
      grid-column: 2;
    }

    .page-aside-rail {
      display: block;
      grid-column: 3;
      justify-self: start;
    }
  }

  .page-content h1 {
    font-size: var(--text-4xl);
    margin-bottom: 1rem;
  }

  .page-content h2 {
    font-size: var(--text-3xl);
    margin: 2rem 0 1rem;
  }

  .page-content h3 {
    font-size: var(--text-2xl);
    margin: 1.5rem 0 0.75rem;
  }

  .page-content p {
    color: var(--text);
    margin: 1rem 0;
    line-height: 1.7;
  }

  .page-content a:not(.btn) {
    color: var(--color-link);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .page-content a:not(.btn):hover {
    color: var(--color-link-hover);
    text-decoration: none;
  }

  .page-content ul,
  .page-content ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .page-content li {
    margin: 0.5rem 0;
    color: var(--text);
  }

  .page-content .text-muted {
    color: var(--text-muted);
  }

  .page-content .text-center {
    text-align: center;
  }
</style>
