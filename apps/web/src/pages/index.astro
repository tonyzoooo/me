---
import { PageLayout } from '@layouts';
import { getPublishedPosts } from '@utils';

const LATEST_POSTS = 5;
const { docs: posts } = await getPublishedPosts();
const latestPosts = posts.slice(0, LATEST_POSTS);
---

<PageLayout
  title="tonyzoooo.me"
  description="Personal blog by me. I build things and write about them."
>
  <h1>Welcome, welcome!</h1>
  <p>
    Grab a drink while you're here 🍺, traveller. It's no coincidence you landed
    here.
  </p>
  <p>What's here? Everything I want to share:</p>
  <ul>
    <li>Projects</li>
    <li>Thoughts</li>
    <li>Experiments</li>
  </ul>
  <p>
    An exposition of sorts. Take your time to explore, and feel free to leave
    feedback.
  </p>

  <h2>Latest Posts</h2>
  {latestPosts.length === 0 ? (
    <p>No posts yet. Check back soon!</p>
  ) : (
    <ul class="latest-list">
      {latestPosts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`}>{post.title}</a>
          {post.publishedDate && (
            <time datetime={post.publishedDate}>
              {new Date(post.publishedDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )}
        </li>
      ))}
    </ul>
  )}
  <p>
    <a href="/blog">See all posts →</a>
  </p>
</PageLayout>

<style>
  .latest-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .latest-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .latest-list a {
    text-decoration: none;
    font-weight: 500;
  }

  .latest-list a:hover {
    color: var(--color-link-hover);
  }

  .latest-list time {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
