---
import { PageLayout } from '@layouts';
import { Breadcrumbs } from '@components';
---

<PageLayout title="About" description="Learn more about Tony">
  <Breadcrumbs crumbs={[{ label: 'About' }]} />
  <h1>About</h1>

  <p>
    I'm Tony, a developer who enjoys building things and writing about them.
  </p>
  <figure>
    <img
      src="/computer-guy.jpg"
      alt="Computer guy"
      class="profile-image"
    />
  </figure>
</PageLayout>

<style>
  figure {
    margin: 2rem 0;
    text-align: center;
  }
  
  .profile-image {
    max-width: 24rem;
    margin: 0 auto;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
  }
</style>
