---
import { PageLayout } from '@layouts';
import { Breadcrumbs } from '@components';
import { getPublishedPosts, getArchivedPosts } from '@utils';
import type { Post } from '@utils';

export async function getStaticPaths() {
  const [published, archived] = await Promise.all([
    getPublishedPosts(),
    getArchivedPosts(),
  ]);
  const posts = [...published.docs, ...archived.docs];
  const byTag = new Map<string, Post[]>();
  for (const post of posts) {
    for (const tag of post.tags ?? []) {
      const list = byTag.get(tag) ?? [];
      list.push(post);
      byTag.set(tag, list);
    }
  }
  return [...byTag.entries()].map(([tag, tagPosts]) => ({
    params: { tag },
    props: { posts: tagPosts },
  }));
}

const { posts: tagPosts } = Astro.props;
const { tag } = Astro.params;
---

<PageLayout title={`#${tag}`} description={`Posts tagged with ${tag}`}>
  <Breadcrumbs
    crumbs={[{ href: '/blog', label: 'Blog' }, { label: `#${tag}` }]}
  />
  <h1>#{tag}</h1>

  {tagPosts.length === 0 ? (
    <p class="text-muted">No posts.</p>
  ) : (
    <ul class="archive-list">
      {tagPosts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`}>{post.title}</a>
          {post.status === 'archived' && (
            <span class="archived-badge">Archived</span>
          )}
          {post.publishedDate && (
            <time datetime={post.publishedDate}>
              {new Date(post.publishedDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )}
        </li>
      ))}
    </ul>
  )}
</PageLayout>

<style>
  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .archive-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .archive-list a {
    text-decoration: none;
    font-weight: 500;
  }

  .archive-list a:hover {
    color: var(--color-link-hover);
  }

  .archive-list time {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .archived-badge {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
