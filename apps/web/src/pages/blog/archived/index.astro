---
import { PageLayout } from '@layouts';
import { Breadcrumbs } from '@components';
import { getArchivedPosts } from '@utils';

const { docs: posts } = await getArchivedPosts();
---

<PageLayout title="Archived posts" description="Posts that have been archived">
  <Breadcrumbs
    crumbs={[{ href: '/blog', label: 'Blog' }, { label: 'Archived' }]}
  />
  <h1>Archived posts</h1>

  {posts.length === 0 ? (
    <p class="text-muted">No archived posts.</p>
  ) : (
    <ul class="archive-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`}>{post.title}</a>
          {post.publishedDate && (
            <time datetime={post.publishedDate}>
              {new Date(post.publishedDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )}
        </li>
      ))}
    </ul>
  )}
</PageLayout>

<style>
  .archive-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .archive-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .archive-list a {
    text-decoration: none;
    font-weight: 500;
  }

  .archive-list a:hover {
    color: var(--color-link-hover);
  }

  .archive-list time {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
