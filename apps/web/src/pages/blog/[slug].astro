---
import { PostLayout } from '@layouts';
import { Breadcrumbs } from '@components';
import { Toc } from '@components';
import {
  getPublishedPosts,
  getArchivedPosts,
  authorName,
  mediaUrl,
} from '@utils';
import type { Post } from '@utils';

// For static site generation
export async function getStaticPaths() {
  const [published, archived] = await Promise.all([
    getPublishedPosts(),
    getArchivedPosts(),
  ]);
  return [...published.docs, ...archived.docs].map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
---

<PostLayout title={post.title} post={post}>
  {post.headings && post.headings.length > 1 && (
    <Toc slot="toc" headings={post.headings} />
  )}
  <Breadcrumbs
    crumbs={[{ href: '/blog', label: 'Blog' }, { label: post.title }]}
  />
  <header>
    <h1>{post.title}</h1>
    <div class="post-meta">
      {post.publishedDate && (
        <time class="post-date" datetime={post.publishedDate}>
          {new Date(post.publishedDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      )}
      {post.stats && <span>{post.stats.readingTime} min read</span>}
      {post.stats && <span>{post.stats.words} words</span>}
      {authorName(post) && <span>By {authorName(post)}</span>}
      {post.status === 'archived' && (
        <span class="archived-flag">Archived</span>
      )}
      {post.updatedAt &&
        (!post.publishedDate ||
          new Date(post.updatedAt) > new Date(post.publishedDate)) && (
          <span>
            Updated{' '}
            {new Date(post.updatedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </span>
        )}
    </div>
    {post.tags && post.tags.length > 0 && (
      <ul class="post-tags not-prose">
        {post.tags.map((tag) => (
          <li class="not-prose">{tag}</li>
        ))}
      </ul>
    )}
    {mediaUrl(post.featuredImage) && (
      <img
        class="post-hero"
        src={mediaUrl(post.featuredImage)}
        alt={post.featuredImage?.alt ?? ''}
        decoding="async"
      />
    )}
  </header>

  {post.htmlContent ? (
    <div class="prose-content" set:html={post.htmlContent} />
  ) : (
    <p class="text-muted">No content</p>
  )}

  <footer class="post-footer">
    <a href="/blog">← Back to blog</a>
  </footer>
</PostLayout>

<style>
  header {
    margin-bottom: 2.5rem;
  }

  header h1 {
    margin-bottom: 0.5rem;
  }

  .post-date {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .archived-flag {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .post-tags li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .post-hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    margin-top: 1rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .post-footer a {
    text-decoration: none;
  }

  .post-footer a:hover {
    color: var(--color-link-hover);
  }
</style>
