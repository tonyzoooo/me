{
  "extends": [
    "astro/tsconfigs/strict",
    "@repo/typescript-config/base.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@layouts": [
        "./src/layouts"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@components": [
        "./src/components"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@pages": [
        "./src/pages"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@utils": [
        "./src/utils"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@styles": [
        "./src/styles"
      ],
      "@styles/*": [
        "./src/styles/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/env.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ]
}